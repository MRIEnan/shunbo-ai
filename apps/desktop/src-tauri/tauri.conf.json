{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shunbo",
  "version": "0.3.2",
  "identifier": "ai.shunbo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Shunbo",
        "url": "index.html",
        "width": 760,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Shunbo overlay",
        "url": "index.html#overlay",
        "width": 420,
        "height": 90,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["shunbo"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
