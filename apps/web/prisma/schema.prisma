generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(user)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  dictations   Dictation[]
  vocabulary   VocabularyWord[]
  snippets     Snippet[]
  stylePresets StylePreset[]
  settings     UserSettings?
  subscription Subscription?
  usage        UsageRecord[]
  apiTokens    ApiToken[]
  meetings     Meeting[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time 6-digit codes for sign-up verification and password reset. Only the hash is stored.
model EmailCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String   // verify | reset
  codeHash  String
  attempts  Int      @default(0)
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

enum Role {
  user
  admin
}

// ---------- Product ----------

/// Editable from the admin dashboard. `slug` is referenced by Subscription.plan.
model PlanConfig {
  slug              String   @id // free | pro | business | ...
  name              String
  description       String?
  priceMonthlyCents Int      @default(0)
  currency          String   @default("usd")
  wordsPerWeek      Int?     // null = unlimited
  features          String[] @default([])
  cta               String   @default("checkout") // checkout | contact | free
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  stripeProductId   String?
  stripePriceId     String?
  meetingMinutesPerMonth Int? // null = unlimited; Notetaker allowance
  updatedAt         DateTime @updatedAt
}

enum Tone {
  formal
  casual
  very_casual
}

model UserSettings {
  userId   String  @id
  tone     Tone    @default(casual)
  language String  @default("auto")
  autoCopy Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dictation {
  id          String   @id @default(cuid())
  userId      String
  raw         String
  clean       String
  tone        Tone
  language    String?
  durationSec Float    @default(0)
  wordCount   Int      @default(0)
  source      String   @default("web") // web | desktop
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model VocabularyWord {
  id        String   @id @default(cuid())
  userId    String
  word      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
}

model Snippet {
  id        String   @id @default(cuid())
  userId    String
  trigger   String // spoken phrase, e.g. "my LinkedIn"
  expansion String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trigger])
}

model StylePreset {
  id           String   @id @default(cuid())
  userId       String
  context      String // e.g. "email", "chat", "notes", or an app name for desktop
  tone         Tone     @default(casual)
  instructions String?  // free-form extra guidance
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, context])
}

model Subscription {
  userId               String    @id
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Long-lived tokens for the desktop app (sent as `Authorization: Bearer`). Only the SHA-256 hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  name       String    @default("Desktop")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  words     Int      @default(0)
  seconds   Int      @default(0) // meeting audio seconds (Notetaker)
  kind      String   @default("dictation") // dictation | meeting
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Notetaker ----------

model Meeting {
  id          String   @id @default(cuid())
  userId      String
  title       String
  status      String   @default("recording") // recording | processing | done | failed
  source      String   @default("desktop")   // desktop | web
  language    String?
  diarize     Boolean  @default(true)
  durationSec Float    @default(0)
  error       String?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  createdAt   DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks   MeetingChunk[]
  segments MeetingSegment[]
  notes    MeetingNotes?

  @@index([userId, startedAt(sort: Desc)])
}

model MeetingChunk {
  id          String   @id @default(cuid())
  meetingId   String
  index       Int
  track       String   // mic | system
  durationSec Float    @default(0)
  status      String   @default("pending") // pending | done | failed
  error       String?
  createdAt   DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, index, track])
}

model MeetingSegment {
  id         String  @id @default(cuid())
  meetingId  String
  chunkIndex Int
  track      String
  speaker    String  // "You", "Speaker 1", ...
  startSec   Float
  endSec     Float
  text       String
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, startSec])
}

model MeetingNotes {
  meetingId   String   @id
  summary     String
  actionItems String[] @default([])
  decisions   String[] @default([])
  questions   String[] @default([])
  generatedAt DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}
