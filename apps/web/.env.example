# ---- Core ----
OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql://user:pass@host:5432/shunboai?sslmode=require
DIRECT_URL=postgresql://user:pass@host:5432/shunboai?sslmode=require    # non-pooled URL for migrations (Neon: without -pooler)
NEXT_PUBLIC_APP_URL=https://shunboai.com

# ---- Auth.js ----
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_TRUST_HOST=true
ADMIN_EMAILS=you@example.com      # comma-separated; these accounts can open /admin

# ---- Magic-link email (any SMTP; Gmail app password shown) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
SMTP_FROM="Shunbo <you@gmail.com>"

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # dev: from `stripe listen`; prod: from the dashboard endpoint

# ---- Optional ----
NEXT_PUBLIC_DOWNLOAD_URL=         # URL of the Windows installer; enables the button on /download
CORS_ORIGINS=                     # extra allowed origins for the desktop app, comma-separated
UPSTASH_REDIS_REST_URL=           # if set, API rate limits are shared across instances
UPSTASH_REDIS_REST_TOKEN=
