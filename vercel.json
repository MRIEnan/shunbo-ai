{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w web",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "functions": {
    "apps/web/src/app/api/transcribe/route.ts": { "maxDuration": 60 },
    "apps/web/src/app/api/clean/route.ts": { "maxDuration": 30 }
  }
}
